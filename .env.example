# SACC Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit your actual keys.

# ── Current: Gemini API (Phase 1-2) ──────────────────────────────────────────
SACC_REMOTE_API_ENABLED=false
SACC_KICKSDB_API_ENABLED=false
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ── Future: Vertex AI (Phase 3) ──────────────────────────────────────────────
# VERTEX_PROJECT_ID=your_gcp_project_id
# VERTEX_LOCATION=us-central1
# VERTEX_MODEL=gemini-3.8-flash

# ── KicksDB Enrichment (Stage 8b) ────────────────────────────────────────────
# Runs after Gemini to append verified colorway, release date, MSRP,
# and live StockX / GOAT asks to each JSON. Pipeline is a no-op if unset.
# Sign up at https://kicks.dev — Starter tier (€29/mo, 50k req/mo) is enough.
# KICKSDB_API_KEY=your_kicksdb_api_key_here
# KICKSDB_BASE_URL=https://api.kicks.dev/v3   # only change if KicksDB updates their URL

# ── Synology / Drive Paths (override defaults in sacc_pipeline.py) ───────────
# SACC_ROOT=/Volumes/Team Bank 12/SACC
# SACC_INBOX=/Volumes/Team Bank 12/SACC/Inbox

# ── Multi-Modal Search PoC ───────────────────────────────────────────────────
# Storage backend: local DAS first; switch to nas after the share is mounted.
SACC_STORAGE_BACKEND=local
SACC_LOCAL_STAGING=/Volumes/External_Drive/staging
# Discovered NAS: smb://Nitty@nasa.local/The%20Final%20Cut%20X
SACC_NAS_ROOT=/Volumes/The Final Cut X
# SACC_NAS_PROTOCOL=smb

# Dedicated PoC database and normalized proxy directory.
# SACC_POC_DB=/absolute/path/to/sacc_multimodal.db
# SACC_PROXY_ROOT=/absolute/path/to/proxies

# Google Gen AI SDK. Vertex AI is preferred when GOOGLE_CLOUD_PROJECT is set.
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
SACC_GEMINI_MODEL=gemini-3.8-flash
SACC_GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
SACC_GEMINI_CONCURRENCY=3
SACC_INGEST_CONCURRENCY=4

# FFmpeg and hard dispatch guardrails.
SACC_PROXY_HEIGHT=720
SACC_PROXY_CRF=23
SACC_PROXY_MAX_BITRATE=4M
SACC_PROXY_AUDIO_BITRATE=96k
SACC_TRANSCODE_CONCURRENCY=2
SACC_MAX_DISPATCH_MB=64
# SACC_FFMPEG=/absolute/path/to/ffmpeg
# SACC_FFPROBE=/absolute/path/to/ffprobe
